# Android emulator: http://10.0.2.2:5000/api/v1
# iOS simulator: http://localhost:5000/api/v1
# Physical Android device: omit this variable when starting Expo with --lan;
# development mode derives the computer's LAN hostname from the Expo dev server.
# For production/native builds, set the API URL explicitly in the build environment.
# Web defaults to http://localhost:5000/api/v1.
# Optional override (must end in /api/v1):
# EXPO_PUBLIC_API_URL=http://your-backend-host:5000/api/v1
