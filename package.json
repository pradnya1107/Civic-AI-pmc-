{
  "name": "civic-ai-pmc",
  "version": "1.0.0",
  "private": true,
  "description": "CivicAI — PMC Civic Issue Reporting & Management Platform",
  "scripts": {
    "dev": "pnpm --filter backend dev",
    "build": "pnpm --filter backend build",
    "start": "pnpm --filter backend start",
    "test": "pnpm --filter backend test",
    "test:types": "pnpm --filter backend test:types",
    "lint": "pnpm --filter backend test:types",
    "frontend:start": "npm --prefix apps/frontend start",
    "frontend:dev": "npm --prefix apps/frontend run dev",
    "frontend:build": "npm --prefix apps/frontend run build",
    "frontend:typecheck": "npm --prefix apps/frontend run typecheck",
    "mobile:typecheck": "npm --prefix apps/frontend run typecheck"
  },
  "packageManager": "pnpm@12.10.1"
}
