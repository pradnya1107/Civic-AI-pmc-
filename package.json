{
  "name": "civic-ai-pmc",
  "version": "1.0.0",
  "private": true,
  "description": "CivicAI — PMC Civic Issue Reporting & Management Platform",
  "scripts": {
    "dev": "pnpm --filter frontend dev",
    "dev:all": "pnpm --parallel --filter backend --filter frontend dev",
    "frontend": "pnpm --filter frontend dev",
    "frontend:dev": "pnpm --filter frontend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "frontend:build": "pnpm --filter frontend build",
    "frontend:test": "pnpm --filter frontend test",
    "frontend:preview": "pnpm --filter frontend preview",
    "backend": "pnpm --filter backend dev",
    "backend:dev": "pnpm --filter backend dev",
    "dev:backend": "pnpm --filter backend dev",
    "backend:build": "pnpm --filter backend build",
    "backend:test": "pnpm --filter backend test",
    "backend:start": "pnpm --filter backend start",
    "start": "pnpm --filter backend start",
    "build": "pnpm --filter backend build && pnpm --filter frontend build",
    "test": "pnpm --filter backend test && pnpm --filter frontend test",
    "test:frontend": "pnpm --filter frontend test",
    "test:backend": "pnpm --filter backend test",
    "test:types": "pnpm --filter backend test:types",
    "lint": "pnpm --filter backend test:types",
    "web": "pnpm --filter frontend dev",
    "dev:web": "pnpm --filter frontend dev",
    "web:dev": "pnpm --filter frontend dev",
    "web:build": "pnpm --filter frontend build",
    "web:test": "pnpm --filter frontend test",
    "web:preview": "pnpm --filter frontend preview"
  },
  "packageManager": "pnpm@12.10.1"
}
